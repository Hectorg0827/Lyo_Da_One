{
  "$schema": "Community release contract shared by iOS, Android, and web",
  "version": 5,
  "referencePlatform": "shared-backend-contract",
  "responsiveRule": "Every client opens on Learning Around Me with a multi-marker, clustered geographic canvas. Phones use a collapsed/medium/expanded bottom sheet; tablets and desktop place results beside the map. Panning never refetches: 'Search this area' does.",
  "canonicalBackend": "https://api.lyoai.app",
  "defaultTab": "Around Me",
  "tabs": [
    "Around Me",
    "My Community",
    "Activity"
  ],
  "nodeCategories": [
    "event",
    "workshop",
    "class",
    "study_group",
    "tutor",
    "library",
    "museum",
    "educational_center"
  ],
  "nodeKinds": [
    "event",
    "study_group",
    "private_lesson",
    "institution"
  ],
  "viewModes": [
    "map",
    "list"
  ],
  "creation": [
    "post",
    "group",
    "event",
    "tutor"
  ],
  "accountOwnedState": [
    "saved_nodes",
    "joined_groups",
    "attending_events",
    "hosting",
    "going",
    "interested",
    "following",
    "invited"
  ],
  "locationPolicy": "Device location is an ephemeral query input, rounded before it is sent for distances, never stored, and never shown to other people. Saves, joins, RSVPs, follows, and user-created learning nodes are stored by authenticated user_id on the backend.",
  "postTypes": [
    "text",
    "question_discussion",
    "study_tip"
  ],
  "postActions": [
    "like",
    "bookmark",
    "comment",
    "share"
  ],
  "commentActions": [
    "create",
    "like",
    "delete"
  ],
  "mapActions": [
    "select_without_navigation",
    "search_this_area",
    "cluster_zoom",
    "save",
    "join",
    "leave",
    "rsvp_going",
    "rsvp_interested",
    "directions",
    "share",
    "add_to_calendar",
    "report",
    "open_course",
    "ask_lyo",
    "open_source",
    "invite_people",
    "accept_invite"
  ],
  "apiPrefix": "/community",
  "canonicalEndpoints": [
    "/community/nearby",
    "/community/me",
    "/community/saved-nodes/{kind}/{nodeId}",
    "/community/posts",
    "/community/posts/{postId}/like",
    "/community/posts/{postId}/bookmark",
    "/community/posts/{postId}/comments",
    "/community/posts/{postId}/comments/{commentId}/like",
    "/community/study-groups",
    "/community/study-groups/{groupId}/join",
    "/community/study-groups/{groupId}/leave",
    "/community/events",
    "/community/events/{eventId}/attend",
    "/community/lessons",
    "/community/nodes/{kind}/{nodeId}",
    "/community/events/{eventId}/rsvp",
    "/community/events/{eventId}/report",
    "/community/search/resolve",
    "/community/geocode",
    "/community/analytics/events",
    "/community/events/{eventId}/invites",
    "/community/events/{eventId}/invites/{inviteId}",
    "/community/events/{eventId}/guests",
    "/community/events/{eventId}/guests/{userId}",
    "/community/invites/{token}",
    "/community/invites/{token}/accept"
  ],
  "design": {
    "primary": "#6366F1",
    "secondary": "#8B5CF6",
    "background": "#0B1230",
    "surface": "#0E173D",
    "textPrimary": "#FFFFFF",
    "textSecondary": "#C9D1F2"
  },
